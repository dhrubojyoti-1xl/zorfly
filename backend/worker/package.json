{
  "name": "@zorfly/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint src test",
    "start": "node dist/src/main.js",
    "test": "vitest run --exclude='dist/**'",
    "test:coverage": "vitest run --coverage --exclude='dist/**'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@zorfly/config": "workspace:*",
    "bullmq": "6.0.2",
    "ioredis": "5.11.1",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.10",
    "tsx": "4.23.1",
    "vitest": "4.1.10"
  }
}
