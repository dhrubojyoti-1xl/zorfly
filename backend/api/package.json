{
  "name": "@zorfly/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint src test",
    "start": "node dist/src/server.js",
    "test": "vitest run --exclude='dist/**'",
    "test:coverage": "vitest run --coverage --exclude='dist/**'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@zorfly/config": "workspace:*",
    "@zorfly/contracts": "workspace:*",
    "@zorfly/database": "workspace:*",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.6.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "nodemailer": "9.0.3",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/nodemailer": "7.0.11",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.10",
    "supertest": "7.2.2",
    "tsx": "4.23.1",
    "vitest": "4.1.10"
  }
}
