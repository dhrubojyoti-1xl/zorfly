# Runtime
NODE_ENV=development
LOG_LEVEL=debug
API_HOST=0.0.0.0
API_PORT=5000
WEB_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5000/api/v1

# PostgreSQL
DATABASE_URL=postgresql://zorfly:zorfly-local@localhost:5432/zorfly?schema=public
DATABASE_DIRECT_URL=postgresql://zorfly:zorfly-local@localhost:5432/zorfly?schema=public

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# S3-compatible object storage
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=zorfly
OBJECT_STORAGE_ACCESS_KEY=zorfly-local
OBJECT_STORAGE_SECRET_KEY=zorfly-local-secret
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=no-reply@zorfly.local

# Authentication secrets: generate unique values; never reuse this example.
SESSION_SIGNING_KEY=
SESSION_ENCRYPTION_KEY=

# AI providers are optional. Configure only approved providers.
AI_DEFAULT_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
LOCAL_AI_BASE_URL=
LOCAL_AI_API_KEY=
