}

enum AIExecutionPurpose {
  QUESTION_GENERATION
  RESPONSE_EVALUATION
  FEEDBACK
  RECOMMENDATION
  IMAGE_GENERATION
  SVG_GENERATION
  MODERATION
  AGENT
  OTHER

