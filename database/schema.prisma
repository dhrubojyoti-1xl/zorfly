  VOID
  UNCOLLECTIBLE

  @@schema("platform")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED

  @@schema("platform")
}

model User {
  id                     String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  externalSubject        String?              @unique @db.VarChar(255)
  emailCanonical         String               @unique @db.VarChar(320)
  displayName            String?              @db.VarChar(200)
  contactNumber          String?              @db.VarChar(32)
  status                 UserStatus           @default(ACTIVE)
  locale                 String               @default("en") @db.VarChar(16)
  timeZone               String               @default("UTC") @db.VarChar(64)
  isPlatformOperator     Boolean              @default(false)
  lastAuthenticatedAt    DateTime?            @db.Timestamptz(6)
  createdAt              DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime             @updatedAt @db.Timestamptz(6)
  deletedAt              DateTime?            @db.Timestamptz(6)
  rowVersion             Int                  @default(1)
  memberships            TenantMembership[]
  credential             UserCredential?
  identities             UserIdentity[]
  sessions               UserSession[]
  passwordResetTokens    PasswordResetToken[]
  supportAccessGrants    SupportAccessGrant[] @relation("SupportGrantee")
  supportAccessApprovals SupportAccessGrant[] @relation("SupportApprover")
  platformRoles          PlatformUserRole[]

  @@index([deletedAt])
  @@index([status, deletedAt])
  @@schema("platform")
}

model UserCredential {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String    @unique @db.Uuid
  passwordHash        String    @db.VarChar(255)
  passwordChangedAt   DateTime  @default(now()) @db.Timestamptz(6)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime? @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt           DateTime? @db.Timestamptz(6)
  rowVersion          Int       @default(1)
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lockedUntil])
  @@index([deletedAt])
  @@schema("platform")
}

model UserIdentity {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String               @db.Uuid
  providerType    IdentityProviderType
  providerKey     String               @db.VarChar(120)
  providerSubject String               @db.VarChar(255)
  emailAtLink     String?              @db.VarChar(320)
  metadata        Json?                @db.JsonB
  lastUsedAt      DateTime?            @db.Timestamptz(6)
  createdAt       DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(6)
  deletedAt       DateTime?            @db.Timestamptz(6)
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerKey, providerSubject])
  @@index([userId, providerType, deletedAt])
  @@schema("platform")
}

model UserSession {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @db.Uuid
  activeTenantId   String?   @db.Uuid
  refreshTokenHash String    @unique @db.Char(64)
  expiresAt        DateTime  @db.Timestamptz(6)
  lastUsedAt       DateTime  @default(now()) @db.Timestamptz(6)
  revokedAt        DateTime? @db.Timestamptz(6)
  revokeReason     String?   @db.VarChar(160)
  sourceIpHash     String?   @db.Char(64)
  userAgentHash    String?   @db.Char(64)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeTenant     Tenant?   @relation(fields: [activeTenantId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt, expiresAt])
  @@index([activeTenantId, expiresAt])
  @@schema("platform")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt, expiresAt])
  @@index([expiresAt])
  @@schema("platform")
}

model Permission {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key               String                   @unique @db.VarChar(160)
  description       String                   @db.VarChar(500)
  riskLevel         Int                      @default(1) @db.SmallInt
  createdAt         DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                 @updatedAt @db.Timestamptz(6)
  roleLinks         TenantRolePermission[]
  platformRoleLinks PlatformRolePermission[]

  @@schema("platform")
}

model PlatformRole {
  id          String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String                   @unique @db.VarChar(80)
  name        String                   @db.VarChar(120)
  description String?                  @db.VarChar(500)
  createdAt   DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime                 @updatedAt @db.Timestamptz(6)
  permissions PlatformRolePermission[]
  users       PlatformUserRole[]

  @@schema("platform")
}

model PlatformRolePermission {
  roleId       String       @db.Uuid
  permissionId String       @db.Uuid
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  role         PlatformRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission   @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@schema("platform")
}

model PlatformUserRole {
  userId      String       @db.Uuid
  roleId      String       @db.Uuid
  grantedById String?      @db.Uuid
  expiresAt   DateTime?    @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(6)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        PlatformRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([expiresAt])
  @@schema("platform")
}

model SubscriptionPlan {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String               @unique @db.VarChar(80)
  name          String               @db.VarChar(120)
  currency      String               @default("USD") @db.Char(3)
  monthlyAmount Decimal              @default(0) @db.Decimal(19, 4)
  annualAmount  Decimal              @default(0) @db.Decimal(19, 4)
  status        RecordStatus         @default(DRAFT)
  createdAt     DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @db.Timestamptz(6)
  deletedAt     DateTime?            @db.Timestamptz(6)
  entitlements  PlanEntitlement[]
  subscriptions TenantSubscription[]

  @@index([status, deletedAt])
  @@schema("platform")
}

model PlanEntitlement {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId     String           @db.Uuid
  featureKey String           @db.VarChar(160)
  enabled    Boolean          @default(true)
  limitValue BigInt?
  config     Json?            @db.JsonB
  createdAt  DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime         @updatedAt @db.Timestamptz(6)
  plan       SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
  @@schema("platform")
}

model QuestionType {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key               String            @unique @db.VarChar(80)
  name              String            @db.VarChar(120)
  answerSchema      Json              @db.JsonB
  supportsAutoScore Boolean           @default(false)
  supportsMedia     Boolean           @default(false)
  status            RecordStatus      @default(ACTIVE)
  createdAt         DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(6)
  questionVersions  QuestionVersion[]

  @@index([status])
  @@schema("platform")
}

model RewardType {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key            String                @unique @db.VarChar(80)
  name           String                @db.VarChar(120)
  description    String?               @db.VarChar(500)
  status         RecordStatus          @default(ACTIVE)
  createdAt      DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime              @updatedAt @db.Timestamptz(6)
  catalogueItems RewardCatalogueItem[]

  @@schema("platform")
}

model Tenant {
  id                      String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                    String                          @unique @db.VarChar(40)
  slug                    String                          @unique @db.VarChar(80)
  name                    String                          @db.VarChar(200)
  status                  TenantStatus                    @default(PROVISIONING)
  dataRegion              String                          @default("ap-south-1") @db.VarChar(32)
  locale                  String                          @default("en") @db.VarChar(16)
  timeZone                String                          @default("UTC") @db.VarChar(64)
  retentionDays           Int                             @default(2555)
  settings                Json?                           @db.JsonB
  createdAt               DateTime                        @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime                        @updatedAt @db.Timestamptz(6)
  createdById             String?                         @db.Uuid
  updatedById             String?                         @db.Uuid
  deletedAt               DateTime?                       @db.Timestamptz(6)
  deletedById             String?                         @db.Uuid
  rowVersion              Int                             @default(1)
  domains                 TenantDomain[]
  branding                TenantBranding?
  branches                Branch[]
  departments             Department[]
  teams                   Team[]
  memberships             TenantMembership[]
  sessions                UserSession[]
  roles                   TenantRole[]
  supportAccessGrants     SupportAccessGrant[]
  subscriptions           TenantSubscription[]
  invoices                Invoice[]
  payments                Payment[]
  categories              AssessmentCategory[]
  difficultyLevels        DifficultyLevel[]
  qualityCriteria         QualityCriterion[]
  tags                    Tag[]
  mediaAssets             MediaAsset[]
  questions               Question[]
  assessments             AssessmentDefinition[]
  learningMaterials       LearningMaterial[]
  learningPaths           LearningPath[]
  candidates              CandidateProfile[]
  recruitmentDrives       RecruitmentDrive[]
  leaderboards            LeaderboardDefinition[]
  badgeDefinitions        BadgeDefinition[]
  rewardCatalogueItems    RewardCatalogueItem[]
  notificationTemplates   NotificationTemplate[]
  notificationPreferences NotificationPreference[]
  reportDefinitions       ReportDefinition[]
  aiProviderConfigs       TenantAIProviderConfiguration[]
  aiModelConfigs          AIModelConfiguration[]
  aiPrompts               AIPrompt[]
  auditEvents             AuditEvent[]
  outboxEvents            OutboxEvent[]
  dataRequests            DataSubjectRequest[]

  @@index([status, deletedAt])
  @@schema("core")
}

model TenantDomain {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @db.Uuid
  hostname   String    @unique @db.VarChar(253)
  isPrimary  Boolean   @default(false)
  verifiedAt DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt  DateTime? @db.Timestamptz(6)
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, isPrimary, deletedAt])
  @@schema("core")
}

model TenantBranding {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String             @unique @db.Uuid
  logoAssetVersionId String?            @db.Uuid
  primaryColor       String?            @db.VarChar(16)
  secondaryColor     String?            @db.VarChar(16)
  accentColor        String?            @db.VarChar(16)
  customCss          String?            @db.Text
  emailFromName      String?            @db.VarChar(120)
  createdAt          DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(6)
  createdById        String?            @db.Uuid
  updatedById        String?            @db.Uuid
  deletedAt          DateTime?          @db.Timestamptz(6)
  deletedById        String?            @db.Uuid
  rowVersion         Int                @default(1)
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  logoAssetVersion   MediaAssetVersion? @relation("BrandLogo", fields: [logoAssetVersionId], references: [id], onDelete: SetNull)

  @@schema("core")
}

model Branch {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String             @db.Uuid
  code        String             @db.VarChar(40)
  name        String             @db.VarChar(160)
  timeZone    String?            @db.VarChar(64)
  status      RecordStatus       @default(ACTIVE)
  createdAt   DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(6)
  createdById String?            @db.Uuid
  updatedById String?            @db.Uuid
  deletedAt   DateTime?          @db.Timestamptz(6)
  deletedById String?            @db.Uuid
  rowVersion  Int                @default(1)
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  departments Department[]
  teams       Team[]
  memberships TenantMembership[]

  @@unique([tenantId, code])
  @@index([tenantId, status, deletedAt])
  @@schema("core")
}

model Department {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String             @db.Uuid
  branchId    String?            @db.Uuid
  parentId    String?            @db.Uuid
  code        String             @db.VarChar(40)
  name        String             @db.VarChar(160)
  status      RecordStatus       @default(ACTIVE)
  createdAt   DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(6)
  createdById String?            @db.Uuid
  updatedById String?            @db.Uuid
  deletedAt   DateTime?          @db.Timestamptz(6)
  deletedById String?            @db.Uuid
  rowVersion  Int                @default(1)
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch      Branch?            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  parent      Department?        @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Department[]       @relation("DepartmentTree")
  teams       Team[]
  memberships TenantMembership[]

  @@unique([tenantId, code])
  @@index([tenantId, parentId, deletedAt])
  @@index([tenantId, branchId, status])
  @@schema("core")
}

model Team {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String           @db.Uuid
  departmentId String?          @db.Uuid
  branchId     String?          @db.Uuid
  code         String           @db.VarChar(40)
  name         String           @db.VarChar(160)
  status       RecordStatus     @default(ACTIVE)
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(6)
  createdById  String?          @db.Uuid
  updatedById  String?          @db.Uuid
  deletedAt    DateTime?        @db.Timestamptz(6)
  deletedById  String?          @db.Uuid
  rowVersion   Int              @default(1)
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  department   Department?      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  branch       Branch?          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  memberships  TeamMembership[]

  @@unique([tenantId, code])
  @@index([tenantId, departmentId, status, deletedAt])
  @@index([tenantId, branchId, status, deletedAt])
  @@schema("core")
}

model TenantMembership {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String                   @db.Uuid
  userId                 String                   @db.Uuid
  branchId               String?                  @db.Uuid
  departmentId           String?                  @db.Uuid
  managerId              String?                  @db.Uuid
  employeeNumber         String?                  @db.VarChar(80)
