  CANCELLED

  @@schema("communications")
}

enum ReportRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  EXPIRED

  @@schema("communications")
}

enum AIExecutionStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  BLOCKED

