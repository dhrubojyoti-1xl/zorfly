}

enum QuestionStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  RETIRED
  ARCHIVED

  @@schema("content")
}

enum VersionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
  RETIRED

