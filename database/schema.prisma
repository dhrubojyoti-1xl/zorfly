// Zorfly production logical schema.
// PostgreSQL policies, partitions, partial indexes, checks, and triggers that
// Prisma cannot express are specified in MIGRATION_STRATEGY.md.

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["ai", "assessment", "communications", "content", "core", "engagement", "learning", "operations", "platform", "recruitment"]
}

enum TenantStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  CLOSING
  CLOSED

  @@schema("core")
}

enum RecordStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED

  @@schema("core")
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  TERMINATED

  @@schema("core")
}

enum IdentityProviderType {
  LOCAL
  OIDC
  SAML

  @@schema("platform")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED

  @@schema("platform")
}

enum SupportAccessStatus {
  REQUESTED
  APPROVED
  ACTIVE
  REVOKED
  EXPIRED

  @@schema("core")
}

enum AssetKind {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  SVG
  OTHER

  @@schema("content")
}

enum AssetStatus {
  PENDING
  PROCESSING
  READY
  QUARANTINED
  REJECTED
  DELETED

