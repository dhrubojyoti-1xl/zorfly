  REDEEM
  EXPIRE

  @@schema("engagement")
}

enum RedemptionStatus {
  REQUESTED
  APPROVED
  FULFILLED
  REJECTED
  CANCELLED

  @@schema("engagement")
}

enum NotificationChannel {
  IN_APP
