  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUALLY
  CUSTOM

  @@schema("assessment")
}

enum CycleStatus {
  PLANNED
  OPEN
  CLOSED
  PROCESSING
  COMPLETED
  CANCELLED

  @@schema("assessment")
