  attempt        AssessmentAttempt? @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  @@index([tenantId, evaluationType, createdAt])
  @@index([tenantId, attemptId])
  @@schema("ai")
}

model AIFeedbackHistory {
  id           BigInt              @id @default(autoincrement())
  tenantId     String              @db.Uuid
  executionId  BigInt
  subjectType  String              @db.VarChar(80)
  subjectId    String              @db.VarChar(255)
  feedback     Json                @db.JsonB
  publishedAt  DateTime?           @db.Timestamptz(6)
  supersedesId BigInt?
  createdAt    DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(6)
  execution    AIPromptExecution   @relation(fields: [executionId], references: [id], onDelete: Restrict)
  supersedes   AIFeedbackHistory?  @relation("FeedbackHistory", fields: [supersedesId], references: [id], onDelete: Restrict)
  revisions    AIFeedbackHistory[] @relation("FeedbackHistory")

  @@index([tenantId, subjectType, subjectId, createdAt])
  @@schema("ai")
}

model AIRecommendation {
  id                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String                 @db.Uuid
  executionId        BigInt
  subjectType        String                 @db.VarChar(80)
  subjectId          String                 @db.VarChar(255)
  recommendationType String                 @db.VarChar(80)
  recommendation     Json                   @db.JsonB
  evidence           Json                   @db.JsonB
  status             AIRecommendationStatus @default(PROPOSED)
  expiresAt          DateTime?              @db.Timestamptz(6)
  decidedAt          DateTime?              @db.Timestamptz(6)
  decidedById        String?                @db.Uuid
  createdAt          DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime               @updatedAt @db.Timestamptz(6)
  execution          AIPromptExecution      @relation(fields: [executionId], references: [id], onDelete: Restrict)

  @@index([tenantId, subjectType, subjectId, status])
  @@index([tenantId, expiresAt])
  @@schema("ai")
}

model AgentRun {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String               @db.Uuid
  executionId          BigInt?
  modelConfigurationId String               @db.Uuid
  agentKey             String               @db.VarChar(120)
  agentVersion         String               @db.VarChar(80)
  status               AgentRunStatus       @default(QUEUED)
  objective            String               @db.Text
  input                Json                 @db.JsonB
  output               Json?                @db.JsonB
  policySnapshot       Json                 @db.JsonB
  currentStep          Int                  @default(0)
  startedAt            DateTime?            @db.Timestamptz(6)
  completedAt          DateTime?            @db.Timestamptz(6)
  createdAt            DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime             @updatedAt @db.Timestamptz(6)
  execution            AIPromptExecution?   @relation(fields: [executionId], references: [id], onDelete: Restrict)
  modelConfiguration   AIModelConfiguration @relation(fields: [modelConfigurationId], references: [id], onDelete: Restrict)
  steps                AgentRunStep[]

  @@index([tenantId, status, createdAt])
  @@index([tenantId, agentKey, agentVersion])
  @@schema("ai")
}

model AgentRunStep {
  id               BigInt         @id @default(autoincrement())
  tenantId         String         @db.Uuid
  agentRunId       String         @db.Uuid
  sequence         Int
  stepType         String         @db.VarChar(80)
  toolName         String?        @db.VarChar(160)
  status           AgentRunStatus
  input            Json?          @db.JsonB
  output           Json?          @db.JsonB
  requiresApproval Boolean        @default(false)
  approvedById     String?        @db.Uuid
  approvedAt       DateTime?      @db.Timestamptz(6)
  startedAt        DateTime?      @db.Timestamptz(6)
  completedAt      DateTime?      @db.Timestamptz(6)
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(6)
  agentRun         AgentRun       @relation(fields: [agentRunId], references: [id], onDelete: Restrict)

  @@unique([agentRunId, sequence])
  @@index([tenantId, status, createdAt])
  @@schema("ai")
}

model AuditEvent {
  id                BigInt         @id @default(autoincrement())
  tenantId          String?        @db.Uuid
  actorType         AuditActorType
  actorId           String?        @db.Uuid
  supportGrantId    String?        @db.Uuid
  action            String         @db.VarChar(160)
  entityType        String         @db.VarChar(160)
  entityId          String?        @db.VarChar(255)
  outcome           AuditOutcome
  reasonCode        String?        @db.VarChar(160)
  requestId         String?        @db.VarChar(128)
  traceId           String?        @db.VarChar(64)
  correlationId     String?        @db.VarChar(128)
  sourceIpHash      String?        @db.Char(64)
  userAgentHash     String?        @db.Char(64)
  beforeState       Json?          @db.JsonB
  afterState        Json?          @db.JsonB
  metadata          Json?          @db.JsonB
  previousEventHash String?        @db.Char(64)
  eventHash         String         @unique @db.Char(64)
  occurredAt        DateTime       @default(now()) @db.Timestamptz(6)
  createdAt         DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(6)
  tenant            Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, entityType, entityId, occurredAt])
  @@index([tenantId, actorId, occurredAt])
  @@index([tenantId, action, outcome, occurredAt])
  @@index([occurredAt], type: Brin)
  @@schema("operations")
}

model AuthorizationDecision {
  id            BigInt         @id @default(autoincrement())
  tenantId      String?        @db.Uuid
  actorType     AuditActorType
  actorId       String?        @db.Uuid
  action        String         @db.VarChar(160)
  resourceType  String         @db.VarChar(160)
  resourceId    String?        @db.VarChar(255)
  allowed       Boolean
  policyVersion String         @db.VarChar(80)
  reasonCodes   Json           @db.JsonB
  requestId     String?        @db.VarChar(128)
  traceId       String?        @db.VarChar(64)
  evaluatedAt   DateTime       @default(now()) @db.Timestamptz(6)
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(6)

  @@index([tenantId, actorId, evaluatedAt])
  @@index([tenantId, resourceType, resourceId, evaluatedAt])
  @@index([evaluatedAt], type: Brin)
  @@schema("operations")
}

model OutboxEvent {
  id             BigInt       @id @default(autoincrement())
  tenantId       String?      @db.Uuid
  aggregateType  String       @db.VarChar(160)
  aggregateId    String       @db.VarChar(255)
  eventType      String       @db.VarChar(160)
  eventVersion   Int
  payload        Json         @db.JsonB
  headers        Json?        @db.JsonB
  idempotencyKey String       @db.VarChar(255)
  status         OutboxStatus @default(PENDING)
  availableAt    DateTime     @default(now()) @db.Timestamptz(6)
  publishedAt    DateTime?    @db.Timestamptz(6)
  attemptCount   Int          @default(0)
  lastError      String?      @db.Text
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)
  tenant         Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, idempotencyKey])
  @@index([status, availableAt])
  @@index([tenantId, aggregateType, aggregateId])
  @@index([createdAt], type: Brin)
  @@schema("operations")
}

model IdempotencyRecord {
  id             BigInt    @id @default(autoincrement())
  tenantId       String?   @db.Uuid
  scope          String    @db.VarChar(120)
  idempotencyKey String    @db.VarChar(255)
  requestHash    String    @db.Char(64)
  responseStatus Int?
  responseBody   Json?     @db.JsonB
  lockedUntil    DateTime? @db.Timestamptz(6)
  completedAt    DateTime? @db.Timestamptz(6)
  expiresAt      DateTime  @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)

  @@unique([tenantId, scope, idempotencyKey])
  @@index([expiresAt])
  @@schema("operations")
}

model DataSubjectRequest {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String            @db.Uuid
  requestType          DataRequestType
  status               DataRequestStatus @default(REQUESTED)
  subjectType          String            @db.VarChar(40)
  subjectId            String            @db.VarChar(255)
  requestedById        String?           @db.Uuid
  verifiedAt           DateTime?         @db.Timestamptz(6)
  approvedById         String?           @db.Uuid
  approvedAt           DateTime?         @db.Timestamptz(6)
  dueAt                DateTime          @db.Timestamptz(6)
  completedAt          DateTime?         @db.Timestamptz(6)
  outputAssetVersionId String?           @db.Uuid
  purgeManifest        Json?             @db.JsonB
  rejectionReason      String?           @db.Text
  createdAt            DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @db.Timestamptz(6)
  rowVersion           Int               @default(1)
  tenant               Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, status, dueAt])
  @@index([tenantId, subjectType, subjectId, createdAt])
  @@schema("operations")
}
