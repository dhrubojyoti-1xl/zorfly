{
  "name": "@zorfly/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "pnpm generate && tsc -p tsconfig.json",
    "clean": "rm -rf dist generated",
    "generate": "prisma generate --schema schema.prisma",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "typecheck": "pnpm generate && tsc -p tsconfig.json --noEmit",
    "validate": "prisma validate --schema schema.prisma"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/pg": "8.15.5",
    "vitest": "4.1.10"
  }
}
